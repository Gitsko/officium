{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
  "id": "19f5868c-d11d-43b0-85f2-a43e164d0c09",
  "manifestVersion": "1.24",
  "version": "1.0.0",
  "name": {
    "short": "Officium",
    "full": "Officium – Kalenderberichte"
  },
  "description": {
    "short": "Termine pro Kunde und Zeitraum zusammenfassen.",
    "full": "Kalendertermine pro Kunde und Zeitraum zusammenfassen, nach Monat oder Quartal gruppieren und als Bericht exportieren."
  },
  "developer": {
    "name": "Gitsko",
    "websiteUrl": "https://github.com/Gitsko/officium",
    "privacyUrl": "https://github.com/Gitsko/officium",
    "termsOfUseUrl": "https://github.com/Gitsko/officium"
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#230201",
  "localizationInfo": {
    "defaultLanguageTag": "de-de",
    "additionalLanguages": []
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.Restricted.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": [],
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "mail"
        ],
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.3"
          }
        ]
      },
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "TaskPaneRuntimeShow",
              "type": "openPage",
              "pinnable": false
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "mailRead",
            "meetingDetailsAttendee",
            "meetingDetailsOrganizer"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "officiumGroup",
                  "label": "Officium",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "officiumOpenPaneButton",
                      "type": "button",
                      "label": "Officium",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Officium",
                        "description": "Kalenderbericht öffnen"
                      },
                      "actionId": "TaskPaneRuntimeShow"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
